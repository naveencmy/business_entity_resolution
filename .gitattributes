# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Explicit text files
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.tsv text eol=lf
*.sh text eol=lf

# Binary files
*.pkl binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
